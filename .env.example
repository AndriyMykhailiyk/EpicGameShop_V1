# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database ───
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── NextAuth ───
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth providers ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Email (Resend) ───
RESEND_API_KEY=your-resend-api-key

# ─── LiqPay (PrivatBank) payment gateway ───
# Get keys at: https://www.liqpay.ua/dashboard/api
LIQPAY_PUBLIC_KEY=sandbox_your_public_key
LIQPAY_PRIVATE_KEY=sandbox_your_private_key
# Set to "1" for sandbox mode (no real charges), "0" for production
LIQPAY_SANDBOX=1

# ─── App URL (used for LiqPay callbacks) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
